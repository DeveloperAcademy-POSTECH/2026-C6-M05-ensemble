<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 초대 링크(iCloud 공유 링크)를 누르면 이 앱이 열리게 한다 (#68). 나머지 항목은 빌드 설정(INFOPLIST_KEY_)에서 자동으로 채워진다 -->
	<key>CKSharingSupported</key>
	<true/>
	<!-- 시스템 메뉴(파일 · 편집 · 보기 · 윈도우 · 도움말, 실행 취소 · 복사 등)를 한국어로 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
		<string>en</string>
	</array>
</dict>
</plist>
